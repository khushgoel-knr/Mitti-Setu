# Configure real values in Vercel Settings > Environment Variables.
# This app expects a Turso libSQL database, not the separate Turso Database engine.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# Optional: Google AI Studio key. Store only in server environment settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative provider; Gemini takes priority when configured.
PLANT_ID_API_KEY=
